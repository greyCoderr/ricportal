# Copy to .env for local development. Fake or local values only; never put real secrets here.
#
# NODE_ENV must be written out (AUD-009). With NODE_ENV=development the server,
# `npm start`, `npm run db:seed` and `npm run db:seed:demo` use the built-in
# local values listed under "Auth" below, so nothing else is needed here.
# If NODE_ENV is missing or empty, the production rules apply and the server
# refuses to start unless JWT_SECRET (32 characters or more), COOKIE_SECURE,
# SESSION_HOURS, ADMIN_USERNAME, ADMIN_PASSWORD and DEFAULT_PASSWORD are all set.
NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root@127.0.0.1:3306/ricportal"
LOG_LEVEL=debug
TZ=Asia/Manila
TRUST_PROXY=0
BODY_LIMIT=100kb
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Auth. With NODE_ENV=development (or test) these six have built-in values, shown
# here, and may stay commented out. With NODE_ENV=production, or no NODE_ENV, all
# six must be set, with your own secret and passwords, never the ones shown here.
# JWT_SECRET=at-least-32-characters
# COOKIE_SECURE=false
# SESSION_HOURS=8
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin2026!
# What a password reset, or a blank password on a new account, sets. A change is
# forced at the next login. Development default RICPortal2026!; production sets its own.
# DEFAULT_PASSWORD=RICPortal2026!
# BCRYPT_COST=12
