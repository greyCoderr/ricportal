{
  "name": "ricportal",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "codegen": "npm run prisma:generate -w @ricportal/server && tsc -b shared",
    "dev:server": "npm run codegen && concurrently -n shared,server \"tsc -b shared -w --preserveWatchOutput\" \"npm run dev -w @ricportal/server\"",
    "typecheck": "npm run codegen && tsc -b",
    "lint": "npm run codegen && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run codegen && vitest run",
    "build": "npm run codegen && tsc -b",
    "clean": "tsc -b --clean",
    "db:migrate": "npm run db:migrate -w @ricportal/server --",
    "db:seed": "npm run db:seed -w @ricportal/server",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
