{
  "name": "ricportal",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "tsc -b shared",
    "typecheck": "tsc -b",
    "lint": "npm run build:shared && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:shared && vitest run",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
