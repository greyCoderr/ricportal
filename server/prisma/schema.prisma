generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "mysql"
}

model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum Role {
  ADMIN
  TEACHER
  PARENT
}

enum UserStatus {
  ACTIVE
  PENDING
  DECLINED
  DISABLED
}

model Center {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique @db.VarChar(120)
  barangay           String?             @db.VarChar(120)
  address            String?             @db.VarChar(255)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  users              User[]
  students           Student[]
  feedingAssignments FeedingAssignment[]
  weekTeamMembers    WeekTeamMember[]
  purchaseRequests   PurchaseRequest[]
  reports            Report[]

  @@map("centers")
}

model User {
  id                 Int                 @id @default(autoincrement())
  role               Role
  // Always stored in lowercase, so the unique index is case-insensitive.
  username           String              @unique @db.VarChar(30)
  passwordHash       String              @map("password_hash") @db.VarChar(100)
  fullName           String              @map("full_name") @db.VarChar(120)
  mobile             String?             @db.VarChar(20)
  centerId           Int?                @map("center_id")
  status             UserStatus          @default(ACTIVE)
  mustChangePassword Boolean             @default(false) @map("must_change_password")
  failedLoginCount   Int                 @default(0) @map("failed_login_count")
  lockedUntil        DateTime?           @map("locked_until")
  tokenVersion       Int                 @default(0) @map("token_version")
  lastLoginAt        DateTime?           @map("last_login_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  center             Center?             @relation(fields: [centerId], references: [id])
  parentProfile      ParentProfile?
  assignments        FeedingAssignment[] @relation("AssignedParent")
  weekTeams          WeekTeamMember[]    @relation("WeekTeamParent")
  reports            Report[]            @relation("ReportTeacher")

  @@index([centerId, role, status])
  @@map("users")
}

model ParentProfile {
  userId    Int      @id @map("user_id")
  childName String?  @map("child_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parent_profiles")
}

enum Gender {
  M
  F
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

model Student {
  id                 Int              @id @default(autoincrement())
  centerId           Int              @map("center_id")
  schoolYear         String           @map("school_year") @db.VarChar(9)
  lastName           String           @map("last_name") @db.VarChar(60)
  firstName          String           @map("first_name") @db.VarChar(60)
  middleName         String?          @map("middle_name") @db.VarChar(60)
  gender             Gender
  birthdate          DateTime         @db.Date
  weightKg           Decimal          @map("weight_kg") @db.Decimal(5, 2)
  heightCm           Decimal          @map("height_cm") @db.Decimal(5, 1)
  parentGuardianName String           @map("parent_guardian_name") @db.VarChar(100)
  enrolledOn         DateTime         @map("enrolled_on") @db.Date
  status             StudentStatus    @default(ACTIVE)
  birthOrder         Int?             @map("birth_order")
  numberOfSiblings   Int?             @map("number_of_siblings")
  religion           String?          @db.VarChar(40)
  ethnicity          String?          @db.VarChar(40)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  center             Center           @relation(fields: [centerId], references: [id])
  conferenceNotes    ConferenceNote[]
  homeVisits         HomeVisit[]
  progressEntries    ChildProgress[]

  @@unique([centerId, schoolYear, lastName, firstName, birthdate])
  @@index([centerId, schoolYear, status])
  @@map("students")
}

model ConferenceNote {
  id        Int       @id @default(autoincrement())
  studentId Int       @map("student_id")
  noteDate  DateTime  @map("note_date") @db.Date
  noteTime  String?   @map("note_time") @db.VarChar(5)
  notes     String    @db.Text
  createdBy Int       @map("created_by")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, noteDate])
  @@map("conference_notes")
}

model HomeVisit {
  id          Int       @id @default(autoincrement())
  studentId   Int       @map("student_id")
  visitDate   DateTime  @map("visit_date") @db.Date
  observation String    @db.Text
  parentInfo  String?   @map("parent_info") @db.Text
  remarks     String?   @db.Text
  createdBy   Int       @map("created_by")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  student     Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, visitDate])
  @@map("home_visits")
}

model ChildProgress {
  id            Int       @id @default(autoincrement())
  studentId     Int       @map("student_id")
  noteDate      DateTime  @map("note_date") @db.Date
  progressNotes String    @map("progress_notes") @db.Text
  createdBy     Int       @map("created_by")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  student       Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, noteDate])
  @@map("child_progress")
}

model MenuBatch {
  id          Int       @id @default(autoincrement())
  sheetName   String    @map("sheet_name") @db.VarChar(100)
  fileName    String    @map("file_name") @db.VarChar(255)
  prNo        String    @map("pr_no") @db.VarChar(30)
  prDate      DateTime  @map("pr_date") @db.Date
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  uploadedBy  Int       @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  days        MenuDay[]

  @@map("menu_batches")
}

model MenuDay {
  id               Int               @id @default(autoincrement())
  batchId          Int               @map("batch_id")
  feedingDate      DateTime          @unique @map("feeding_date") @db.Date
  dayNo            Int               @map("day_no")
  dayName          String            @map("day_name") @db.VarChar(20)
  menuName         String            @map("menu_name") @db.VarChar(200)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  batch            MenuBatch         @relation(fields: [batchId], references: [id])
  purchaseRequests PurchaseRequest[]

  @@index([batchId])
  @@map("menu_days")
}

enum PurchaseRequestStatus {
  OPEN
  LOCKED
  NO_FEEDING
}

model FeedingAssignment {
  id          Int      @id @default(autoincrement())
  centerId    Int      @map("center_id")
  feedingDate DateTime @map("feeding_date") @db.Date
  parentId    Int      @map("parent_id")
  assignedBy  Int      @map("assigned_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  center      Center   @relation(fields: [centerId], references: [id])
  parent      User     @relation("AssignedParent", fields: [parentId], references: [id])

  @@unique([centerId, feedingDate, parentId])
  @@index([parentId, feedingDate])
  @@map("feeding_assignments")
}

// The team of at most 4 parents for one week of one center (D4). Kept apart from
// the day rows, so a team member with no days yet is not lost.
model WeekTeamMember {
  id         Int      @id @default(autoincrement())
  centerId   Int      @map("center_id")
  weekStart  DateTime @map("week_start") @db.Date
  parentId   Int      @map("parent_id")
  assignedBy Int      @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")
  center     Center   @relation(fields: [centerId], references: [id])
  parent     User     @relation("WeekTeamParent", fields: [parentId], references: [id])

  @@unique([centerId, weekStart, parentId])
  @@index([parentId])
  @@map("week_team_members")
}

model PurchaseRequest {
  id                Int                   @id @default(autoincrement())
  centerId          Int                   @map("center_id")
  feedingDate       DateTime              @map("feeding_date") @db.Date
  menuDayId         Int                   @map("menu_day_id")
  prNo              String                @map("pr_no") @db.VarChar(30)
  status            PurchaseRequestStatus @default(OPEN)
  // Snapshots, set on lock (BR-10). Null while OPEN.
  enrolledCount     Int?                  @map("enrolled_count")
  ratePerChild      Decimal?              @map("rate_per_child") @db.Decimal(10, 2)
  budget            Decimal?              @db.Decimal(12, 2)
  lockedAt          DateTime?             @map("locked_at")
  lockedBy          Int?                  @map("locked_by")
  submittedReportId Int?                  @map("submitted_report_id")
  submittedReport   Report?               @relation(fields: [submittedReportId], references: [id])
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  center            Center                @relation(fields: [centerId], references: [id])
  menuDay           MenuDay               @relation(fields: [menuDayId], references: [id])
  items             PurchaseItem[]

  @@unique([centerId, feedingDate])
  @@index([menuDayId])
  @@map("purchase_requests")
}

model PurchaseItem {
  id                Int             @id @default(autoincrement())
  purchaseRequestId Int             @map("purchase_request_id")
  itemNo            Int             @map("item_no")
  description       String          @db.VarChar(80)
  unit              String?         @db.VarChar(10)
  quantity          Decimal?        @db.Decimal(10, 3)
  unitCost          Decimal?        @map("unit_cost") @db.Decimal(10, 2)
  filledBy          Int?            @map("filled_by")
  // Who added the row (D3). Null on rows older than this column.
  createdBy         Int?            @map("created_by")
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId, itemNo])
  @@map("purchase_items")
}

enum ReportType {
  LIQUIDATION
}

enum ReportStatus {
  SUBMITTED
  NEED_REVISION
  APPROVED
}

enum ReviewDecision {
  APPROVED
  NEED_REVISION
}

model Report {
  id               Int                   @id @default(autoincrement())
  centerId         Int                   @map("center_id")
  teacherId        Int                   @map("teacher_id")
  type             ReportType
  periodStart      DateTime              @map("period_start") @db.Date
  periodEnd        DateTime              @map("period_end") @db.Date
  status           ReportStatus          @default(SUBMITTED)
  currentVersion   Int                   @default(1) @map("current_version")
  submittedAt      DateTime              @default(now()) @map("submitted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  center           Center                @relation(fields: [centerId], references: [id])
  teacher          User                  @relation("ReportTeacher", fields: [teacherId], references: [id])
  reviews          ReportReview[]
  snapshots        LiquidationSnapshot[]
  purchaseRequests PurchaseRequest[]

  @@index([centerId, periodStart])
  @@map("reports")
}

model ReportReview {
  id         Int            @id @default(autoincrement())
  reportId   Int            @map("report_id")
  versionNo  Int            @map("version_no")
  reviewerId Int            @map("reviewer_id")
  decision   ReviewDecision
  feedback   String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  report     Report         @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("report_reviews")
}

model LiquidationSnapshot {
  id        Int      @id @default(autoincrement())
  reportId  Int      @map("report_id")
  versionNo Int      @map("version_no")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  report    Report   @relation(fields: [reportId], references: [id])

  @@unique([reportId, versionNo])
  @@map("liquidation_snapshots")
}
