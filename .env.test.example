# Copy to .env.test for the test suite. Uses the separate ricportal_test database only.
NODE_ENV=test
PORT=3001
DATABASE_URL="mysql://root@127.0.0.1:3306/ricportal_test"
LOG_LEVEL=silent
TZ=Asia/Manila
TRUST_PROXY=0
BODY_LIMIT=100kb
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
